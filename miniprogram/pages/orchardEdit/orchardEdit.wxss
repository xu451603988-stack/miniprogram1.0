.page{ padding:24rpx; background:#f5f7f9; min-height:100vh; box-sizing:border-box; }
.header{ margin-bottom:20rpx; }
.title{ font-size:36rpx; font-weight:800; color:#1f2937; }
.subtitle{ margin-top:8rpx; font-size:24rpx; color:#6b7280; }

.card{ background:#fff; border-radius:16rpx; padding:20rpx; box-shadow:0 4rpx 12rpx rgba(0,0,0,.04); }

.row{ display:flex; align-items:center; margin-bottom:16rpx; }
.row.col{ flex-direction:column; align-items:flex-start; }
.label{ width:160rpx; font-size:26rpx; color:#374151; }
.input{
  flex:1; border:1rpx solid #e5e7eb; border-radius:10rpx;
  padding:12rpx; font-size:26rpx; box-sizing:border-box;
}
.textarea{
  width:100%; min-height:160rpx;
  border:1rpx solid #e5e7eb; border-radius:10rpx;
  padding:12rpx; font-size:26rpx; box-sizing:border-box;
}

.footer{ margin:24rpx 0 40rpx; }
.btn{ width:100%; height:88rpx; border-radius:12rpx; font-size:30rpx; background:#4caf50; color:#fff; }
