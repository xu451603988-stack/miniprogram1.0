.container {
  padding: 24rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 18rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.06);
}

.label {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.text {
  font-size: 28rpx;
  line-height: 1.7;
  color: #333;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.btn {
  flex: 1;
}

.primary {
  background: #2f7d32;
  color: #fff;
}
