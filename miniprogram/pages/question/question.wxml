<view class="page">

<!-- 顶部提示 -->
<view class="hint">
  <text class="hint-main">正在生成下一题…</text>
  <text class="hint-sub">如果信息不足，会自动给出初步建议</text>
</view>

<!-- 先看初步建议 -->
<view
  class="preview-btn"
  wx:if="{{!loading && !currentQuestion}}"
  bindtap="goResult"
>
  先看初步建议
</view>

<!-- 加载态 -->
<view class="loading" wx:if="{{loading}}">
  <text>分析中，请稍候…</text>
</view>

<!-- 问题卡片 -->
<view class="question-card" wx:if="{{currentQuestion}}">

  <!-- 问题标题 -->
  <view class="q-title">
    {{currentQuestion.title}}
  </view>

  <!-- 问题描述（可选） -->
  <view class="q-desc" wx:if="{{currentQuestion.desc}}">
    {{currentQuestion.desc}}
  </view>

  <!-- 单选题 -->
  <view wx:if="{{currentQuestion.type === 'single'}}">
    <view
      class="option {{selectedMap[item.value] ? 'option--active' : ''}}"
      wx:for="{{currentQuestion.options}}"
      wx:key="value"
      data-value="{{item.value}}"
      bindtap="onSelectOption"
    >
      <view class="opt-left">
        <view class="radio {{selectedMap[item.value] ? 'radio--active' : ''}}"></view>
        <text class="opt-text">{{item.label}}</text>
      </view>
      <view class="check" wx:if="{{selectedMap[item.value]}}">✓</view>
    </view>
  </view>

  <!-- 多选题 -->
  <view wx:if="{{currentQuestion.type === 'multi'}}">
    <view
      class="option {{selectedMap[item.value] ? 'option--active' : ''}}"
      wx:for="{{currentQuestion.options}}"
      wx:key="value"
      data-value="{{item.value}}"
      bindtap="onSelectOption"
    >
      <view class="opt-left">
        <view class="checkbox {{selectedMap[item.value] ? 'checkbox--active' : ''}}">
          <text class="checkbox-mark" wx:if="{{selectedMap[item.value]}}">✓</text>
        </view>
        <text class="opt-text">{{item.label}}</text>
      </view>
    </view>

    <view class="confirm-btn" bindtap="onConfirmMulti">
      下一步
    </view>
  </view>
</view>

<!-- toast -->
<view class="toast" wx:if="{{toast}}">
  {{toast}}
</view>

</view>
