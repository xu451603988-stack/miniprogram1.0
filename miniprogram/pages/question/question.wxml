<view class="page">

<!-- 无题占位 -->
<view wx:if="{{!currentQuestion}}" class="empty">
  <text class="empty-title">正在生成下一题...</text>
  <text class="empty-desc">如果信息不足，会自动给出初步建议</text>
  <button class="btn" bindtap="goResult">先看初步建议</button>
</view>

<!-- 有题才渲染 -->
<view wx:elif="{{currentQuestion}}" class="card">

  <view class="title">
    <text>{{currentQuestion.title}}</text>
  </view>

  <view wx:if="{{currentQuestion.hint}}" class="hint">
    <text>{{currentQuestion.hint}}</text>
  </view>

  <!-- 单选题 -->
  <view wx:if="{{currentQuestion.type === 'single'}}" class="options">
    <block wx:for="{{currentQuestion.options}}" wx:key="value">
      <view
        class="option {{ selectedMap[item.value] ? 'option--selected' : '' }}"
        data-value="{{item.value}}"
        bindtap="onSelectOption"
      >
        <text>{{item.label}}</text>
      </view>
    </block>
  </view>

  <!-- 多选题 -->
  <view wx:elif="{{currentQuestion.type === 'multi'}}" class="options">
    <block wx:for="{{currentQuestion.options}}" wx:key="value">
      <view
        class="option {{ selectedMap[item.value] ? 'option--selected' : '' }}"
        data-value="{{item.value}}"
        bindtap="onSelectOption"
      >
        <text>{{item.label}}</text>
      </view>
    </block>

    <button class="btn" bindtap="onConfirmMulti">下一步</button>
    <view class="tip">
      <text>提示：可选 1~2 项，选完点“下一步”。</text>
    </view>
  </view>

  <!-- 兜底 -->
  <view wx:else class="empty">
    <text class="empty-title">题目类型暂不支持</text>
    <button class="btn" bindtap="goResult">先看初步建议</button>
  </view>

</view>
</view>
