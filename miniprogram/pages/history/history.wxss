.page {
  min-height: 100vh;
  background: #f6f6f6;
  padding: 20rpx 20rpx 40rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 18rpx;
  padding: 22rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 6rpx 18rpx rgba(0,0,0,0.06);
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.h-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f1f1f;
}

.h-sub {
  font-size: 24rpx;
  color: #6b6b6b;
}

.actions {
  margin-top: 14rpx;
  display: flex;
  justify-content: flex-end;
}

.btn {
  border-radius: 16rpx;
}

.ghost {
  background: #f2f4f6;
  color: #333;
}

.list .item {
  padding: 22rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.title {
  font-size: 30rpx;
  font-weight: 800;
  color: #111;
  line-height: 1.3;
  flex: 1;
}

.badge {
  font-size: 22rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(47, 125, 50, 0.10);
  color: #2f7d32;
  font-weight: 800;
  flex: 0 0 auto;
}

.sub {
  margin-top: 10rpx;
}

.muted {
  font-size: 26rpx;
  color: #7a7a7a;
  line-height: 1.7;
}

.flags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.chip {
  font-size: 22rpx;
  color: #2a2a2a;
  background: #f2f4f6;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
}

.footer {
  margin-top: 14rpx;
}

.del {
  font-size: 26rpx;
  color: #d43c33;
  font-weight: 700;
}
