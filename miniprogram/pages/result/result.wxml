<view class="page">

<!-- A 主：主要判断 + 处置 -->
<view class="card" wx:if="{{vm}}">
  <view class="header">
    <view class="h-title">诊断结果</view>
    <view class="h-sub">判断情况：{{vm.confidenceText}}</view>
  </view>

  <view class="primary">
    <view class="primary-title">更像是：{{vm.aTitle}}</view>
    <view class="p muted" wx:if="{{vm.aSubhead}}">{{vm.aSubhead}}</view>
  </view>

  <view class="divider"></view>

  <view class="section">
    <view class="section-title">{{vm.actionsTitle}}</view>
    <view class="steps" wx:if="{{vm.actionsSteps && vm.actionsSteps.length}}">
      <view class="step" wx:for="{{vm.actionsSteps}}" wx:key="index">
        <view class="dot"></view>
        <view class="step-text">{{item}}</view>
      </view>
    </view>

    <view class="section" wx:if="{{vm.actionsDonts && vm.actionsDonts.length}}">
      <view class="section-title">不建议做</view>
      <view class="notes">
        <view class="note" wx:for="{{vm.actionsDonts}}" wx:key="index">• {{item}}</view>
      </view>
    </view>

    <view class="section" wx:if="{{vm.actionsEscalate && vm.actionsEscalate.length}}">
      <view class="section-title">何时建议线下/专家</view>
      <view class="notes">
        <view class="note" wx:for="{{vm.actionsEscalate}}" wx:key="index">• {{item}}</view>
      </view>
    </view>
  </view>
</view>

<!-- B 辅：为什么这么判断（默认折叠） -->
<view class="card" wx:if="{{vm && vm.whyList && vm.whyList.length}}">
  <view class="fold-header" bindtap="toggleWhy">
    <view class="h-title">{{vm.whyTitle}}</view>
    <view class="fold-tip">{{showWhy ? '收起' : '展开'}}</view>
  </view>

  <view wx:if="{{showWhy}}" class="notes">
    <view class="note" wx:for="{{vm.whyList}}" wx:key="index">• {{item}}</view>
  </view>

  <view wx:else class="muted">默认折叠：展开可查看原因说明。</view>
</view>

<!-- B 辅：可能相关原因（默认折叠） -->
<view class="card" wx:if="{{vm && vm.possibleCauses && vm.possibleCauses.length}}">
  <view class="fold-header" bindtap="toggleCauses">
    <view class="h-title">{{vm.causesTitle}}</view>
    <view class="fold-tip">{{showCauses ? '收起' : '展开'}}</view>
  </view>

  <view wx:if="{{showCauses}}" class="notes">
    <view class="note" wx:for="{{vm.possibleCauses}}" wx:key="index">• {{item}}</view>
  </view>

  <view wx:else class="muted">默认折叠：展开可查看可能原因（供参考）。</view>
</view>

<!-- 其他可能（默认折叠，可切换查看） -->
<view class="card" wx:if="{{pkg && pkg.alternativesSection && pkg.alternativesSection.items && pkg.alternativesSection.items.length}}">
  <view class="fold-header" bindtap="toggleAlts">
    <view class="h-title">其他可能情况</view>
    <view class="fold-tip">{{showAlts ? '收起' : '展开'}}</view>
  </view>

  <view wx:if="{{showAlts}}" class="cand-list">
    <view
      class="cand-item"
      wx:for="{{pkg.alternativesSection.items}}"
      wx:key="code"
      data-code="{{item.code}}"
      bindtap="onPickAlternative"
    >
      <view class="cand-left">
        <view class="cand-code">{{item.label}}</view>
        <view class="cand-sub muted">点击查看对应处理建议</view>
      </view>
      <view class="cand-right">查看</view>
    </view>
  </view>

  <view wx:else class="muted">默认折叠：展开可查看其它可能，并可点开查看方案。</view>
</view>

<!-- 建议补充信息（默认折叠） -->
<view class="card" wx:if="{{vm && vm.followups && vm.followups.length}}">
  <view class="fold-header" bindtap="toggleFollowups">
    <view class="h-title">{{vm.followupsTitle}}</view>
    <view class="fold-tip">{{showFollowups ? '收起' : '展开'}}</view>
  </view>

  <view wx:if="{{showFollowups}}" class="notes">
    <view class="note" wx:for="{{vm.followups}}" wx:key="index">• {{item}}</view>
  </view>

  <view wx:else class="muted">默认折叠：展开可查看补充哪些信息更准确。</view>
</view>

<!-- Footer -->
<view class="footer">
  <button class="btn" bindtap="goHistory">历史记录</button>
  <button class="btn primary" bindtap="goExpert">专家咨询</button>
</view>

</view>
