.page {
  min-height: 100vh;
  background: #f6f6f6;
  padding: 20rpx 20rpx 40rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 18rpx;
  padding: 22rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 6rpx 18rpx rgba(0,0,0,0.06);
}

.header, .fold-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.h-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f1f1f;
}

.h-sub {
  font-size: 24rpx;
  color: #6b6b6b;
}

.fold-tip {
  font-size: 24rpx;
  color: #2f7d32;
}

.primary {
  margin-top: 16rpx;
}

.primary-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #111;
  line-height: 1.2;
}

.primary-code {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #666;
}

.meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.chip {
  font-size: 22rpx;
  color: #2a2a2a;
  background: #f2f4f6;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
}

.divider {
  height: 1px;
  background: #eee;
  margin: 18rpx 0;
}

.section {
  margin-top: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f1f1f;
  margin-bottom: 10rpx;
}

.p {
  font-size: 28rpx;
  color: #303030;
  line-height: 1.7;
}

.steps {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.step {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #2f7d32;
  margin-top: 12rpx;
  flex: 0 0 auto;
}

.step-text {
  font-size: 28rpx;
  color: #303030;
  line-height: 1.7;
}

.notes .note {
  font-size: 26rpx;
  color: #444;
  line-height: 1.7;
  margin-top: 8rpx;
}

.muted {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #7a7a7a;
  line-height: 1.7;
}

.cand-list {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.cand-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx;
  border: 1px solid #eee;
  border-radius: 14rpx;
}

.cand-item.active {
  border-color: #2f7d32;
  background: rgba(47, 125, 50, 0.06);
}

.cand-code {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f1f1f;
}

.cand-right {
  font-size: 26rpx;
  color: #2f7d32;
  font-weight: 700;
}

.tag {
  padding: 18rpx;
  border: 1px solid #eee;
  border-radius: 14rpx;
  margin-top: 14rpx;
}

.tag-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tag-name {
  font-size: 28rpx;
  font-weight: 800;
  color: #1f1f1f;
}

.tag-score {
  font-size: 24rpx;
  color: #2f7d32;
  font-weight: 700;
}

.tag-block {
  margin-top: 12rpx;
}

.tag-sub {
  font-size: 26rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 8rpx;
}

.tag-li {
  font-size: 26rpx;
  color: #444;
  line-height: 1.7;
  margin-top: 6rpx;
}

.qa {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.qa-item {
  padding: 16rpx;
  border-radius: 14rpx;
  background: #f7f8fa;
}

.qa-q {
  font-size: 26rpx;
  font-weight: 700;
  color: #222;
}

.qa-a {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #444;
  line-height: 1.6;
}

.footer {
  display: flex;
  gap: 16rpx;
  margin-top: 14rpx;
}

.btn {
  flex: 1;
  border-radius: 16rpx;
}

.primary {
  background: #2f7d32;
  color: #fff;
}
